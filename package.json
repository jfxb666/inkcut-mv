{
  "name": "inkcut",
  "version": "1.0.0",
  "description": "Ink-wash x paper-cut music video pipeline: measured beat grid, AI-shot footage, word-accurate lyrics, rendered with Remotion",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "analyze": "node scripts/analyze.mjs",
    "refs": "node scripts/refs.mjs",
    "clips": "node scripts/gen-clips.mjs",
    "plates": "node scripts/plates.mjs",
    "sync": "node scripts/sync-assets.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "studio": "remotion studio",
    "still": "remotion still InkCut out/still.png",
    "render": "remotion render InkCut out/film.mp4 --codec=h264 --crf=18",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && tsc"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/zod-types": "^4.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "^4.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "^4.0.0",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
